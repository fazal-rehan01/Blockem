{
  "manifest_version": 2,
  "name": "Blockem",
  "version": "2.0.0",
  "description": "A local-first Firefox content and phishing filter.",
  "browser_specific_settings": {
    "gecko": {
      "id": "blockem@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "contextualIdentities",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["shared.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Blockem",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    "blocked.html",
    "blocked.css",
    "blocked.js",
    "icons/*"
  ]
}
